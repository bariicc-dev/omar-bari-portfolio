---
import { leadsSim } from '../../data/leadsSim';
import type { Lang } from '../../data/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = leadsSim[lang];
const u = s.ui;
const passWord = lang === 'fr' ? 'validé' : 'passed';
const failWord = lang === 'fr' ? 'refusé' : 'failed';
---

<div class="lab" data-lab>
  <div class="lab-top">
    <p class="lab-id"><span class="lab-led" aria-hidden="true"></span>{u.name}</p>
    <p class="lab-sim">{u.sim}</p>
  </div>

  <div class="picks" role="group" aria-label={u.pickLabel}>
    {
      s.records.map((r, i) => (
        <button type="button" class="pick" data-pick={r.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="pick-name">{r.label}</span>
          <span class="pick-hint">{r.hint}</span>
        </button>
      ))
    }
  </div>

  {
    s.records.map((r, i) => (
      <div
        class="rec"
        data-rec={r.id}
        data-to={r.to}
        data-phase="done"
        data-raw="on"
        data-msg-idle={r.idle}
        data-msg-running={r.running}
        data-msg-done={r.done}
        data-msg-again={r.again}
        hidden={i !== 0}
      >
        <div class="lanes">
          <section class="lane" aria-label={u.raw.title}>
            <header class="lane-head">
              <span class="lane-title">{u.raw.title}</span>
              <span class="lane-count" data-count="raw">1</span>
            </header>
            <p class="lane-sub">{u.raw.sub}</p>
            <div class="src">
              <p class="src-label">{u.source}</p>
              <ol class="attempts">
                {r.attempts.map((a) => (
                  <li class="att" data-ok={a.ok ? 'true' : 'false'} data-state="shown">
                    <span class="att-mark" aria-hidden="true">{a.ok ? '✓' : '✕'}</span>
                    <span>{a.text}</span>
                  </li>
                ))}
              </ol>
              <p class="src-wait">{u.notFetched}</p>
            </div>
            <div class="rcard rcard--raw">
              <p class="rcard-id">{r.rawId}</p>
              <dl>
                {r.raw.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </section>

          <span class="pipe" aria-hidden="true" />

          <section class="lane" aria-label={u.gate.title}>
            <header class="lane-head">
              <span class="lane-title">{u.gate.title}</span>
            </header>
            <p class="lane-sub">{u.gate.sub}</p>
            <ol class="rules">
              {r.rules.map((rule) => (
                <li class="rule" data-final={rule.ok ? 'pass' : 'fail'} data-state={rule.ok ? 'pass' : 'fail'}>
                  <span class="rule-led" aria-hidden="true" />
                  <span class="rule-text">
                    <span>{rule.name}</span>
                    <span class="rule-eng eng-only">{rule.eng}</span>
                  </span>
                  <span class="sr">{rule.ok ? passWord : failWord}</span>
                </li>
              ))}
            </ol>
          </section>

          <span class="pipe" aria-hidden="true" />

          <div class="lane-stack">
            <section class:list={['lane', 'lane--clean', { 'has-card': r.to === 'clean' }]} aria-label={u.clean.title}>
              <header class="lane-head">
                <span class="lane-title">{u.clean.title}</span>
                <span class="lane-count" data-count="clean">
                  {r.to === 'clean' ? 1 : 0}
                </span>
              </header>
              <p class="lane-sub">{u.clean.sub}</p>
              {r.to === 'clean' && (
                <div class="rcard rcard--out">
                  <dl>
                    {r.out.map(([k, v]) => (
                      <div>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}
              <p class="lane-empty">{u.waiting}</p>
            </section>
            <section class:list={['lane', 'lane--review', { 'has-card': r.to === 'review' }]} aria-label={u.review.title}>
              <header class="lane-head">
                <span class="lane-title">{u.review.title}</span>
                <span class="lane-count" data-count="review">
                  {r.to === 'review' ? 1 : 0}
                </span>
              </header>
              <p class="lane-sub">{u.review.sub}</p>
              {r.to === 'review' && (
                <div class="rcard rcard--review">
                  <dl>
                    {r.out.map(([k, v]) => (
                      <div>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}
              <p class="lane-empty">{u.waiting}</p>
            </section>
          </div>
        </div>

        <div class="lab-bar">
          <div class="lab-actions needs-js">
            <button type="button" class="lbtn lbtn--go" data-lab-act="run">
              {u.run}
            </button>
            <button type="button" class="lbtn" data-lab-act="again">
              {u.again}
            </button>
            <button type="button" class="lbtn" data-lab-act="reset">
              {u.reset}
            </button>
          </div>
          <p class="lab-msg" data-msg>
            {r.done}
          </p>
        </div>
      </div>
    ))
  }
  <p class="sr" aria-live="polite" data-live></p>
</div>

<noscript>
  <style>
    .lab .rec[hidden] {
      display: block !important;
      margin-top: 2rem;
    }
  </style>
</noscript>

<style>
  .lab {
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border: 1px solid var(--line-2);
    border-radius: 22px;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
  }
  .lab-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    padding-bottom: 1rem;
  }
  .lab-id {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 650;
    font-stretch: 108%;
  }
  .lab-led {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .lab-sim {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 580;
    color: var(--text-2);
  }
  .lab-sim::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ask);
  }

  .picks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 1rem;
  }
  .pick,
  .lbtn {
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--bg-2);
    color: var(--text);
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      transform 0.12s var(--ease);
  }
  .pick:hover,
  .lbtn:hover {
    border-color: var(--line-3);
  }
  .pick:active,
  .lbtn:active {
    transform: translateY(1px);
  }
  .pick {
    display: grid;
    gap: 0.1rem;
    min-height: 2.75rem;
    padding: 0.55rem 0.95rem;
    text-align: left;
  }
  .pick[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .pick-name {
    font-weight: 620;
  }
  .pick-hint {
    font-size: 0.82rem;
    color: var(--text-2);
  }

  .lanes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2rem minmax(0, 1fr) 2rem minmax(0, 1.05fr);
    align-items: stretch;
  }
  .lane {
    min-width: 0;
    padding: 0.95rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-2);
  }
  .lane-stack {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
  }
  .lane-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .lane-title {
    font-size: 0.82rem;
    font-weight: 700;
    font-stretch: 110%;
    letter-spacing: 0.05em;
  }
  .lane--clean .lane-title {
    color: var(--accent);
  }
  .lane--review .lane-title {
    color: var(--stop);
  }
  .lane-count {
    min-width: 1.6rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-family: var(--mono);
    font-stretch: 87.5%;
    font-size: 0.72rem;
    text-align: center;
  }
  .lane-sub {
    margin-top: 0.3rem;
    font-size: 0.84rem;
    line-height: 1.4;
    color: var(--text-2);
  }

  .pipe {
    align-self: center;
    justify-self: center;
    width: 100%;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--line-3) 0 6px, transparent 6px 11px);
    background-size: 11px 2px;
  }
  .rec[data-phase='running'] .pipe {
    background-image: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 11px);
    animation: flow 0.5s linear infinite;
  }
  @keyframes flow {
    to {
      background-position: 11px 0;
    }
  }

  .rcard {
    margin-top: 0.85rem;
    padding: 0.7rem 0.8rem;
    border-radius: 10px;
    font-family: var(--mono);
    font-stretch: 87.5%;
    font-size: 0.74rem;
    line-height: 1.55;
  }
  .rcard dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 0.8rem;
    row-gap: 0.15rem;
    margin: 0;
  }
  .rcard dl div {
    display: contents;
  }
  .rcard dt {
    color: var(--text-3);
  }
  .rcard dd {
    min-width: 0;
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .rcard-id {
    margin-bottom: 0.4rem;
    font-size: 0.68rem;
    color: var(--text-3);
  }
  .rcard--raw {
    border: 1px dashed var(--line-3);
    background: var(--surface-2);
  }
  .rcard--raw dd {
    color: var(--ask);
  }
  .rcard--out {
    border: 1px solid rgba(200, 242, 80, 0.35);
    background: var(--accent-soft);
  }
  .rcard--out dd {
    color: #e6f7c4;
  }
  .rcard--review {
    border: 1px solid rgba(255, 122, 110, 0.35);
    background: var(--stop-soft);
  }
  .rcard--review dd {
    color: #ffd1cc;
  }
  .rec[data-phase='done'] .rcard--out,
  .rec[data-phase='done'] .rcard--review {
    animation: arrive 0.6s var(--ease);
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }
  }
  .rcard.pulse {
    animation: pulse 0.9s ease;
  }
  @keyframes pulse {
    30% {
      box-shadow: 0 0 0 4px rgba(200, 242, 80, 0.35);
    }
  }
  .lane-empty {
    display: none;
    margin-top: 0.85rem;
    padding: 0.7rem 0.8rem;
    border: 1px dashed var(--line-2);
    border-radius: 10px;
    font-size: 0.82rem;
    color: var(--text-2);
  }
  .lane:not(.has-card) .lane-empty,
  .rec[data-phase='idle'] .lane-empty,
  .rec[data-phase='running'] .lane-empty {
    display: block;
  }
  .rec[data-raw='off'] .rcard--raw {
    display: none;
  }

  .src {
    margin-top: 0.85rem;
    padding: 0.6rem 0.7rem;
    border-radius: 10px;
    background: var(--surface-2);
  }
  .src-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-2);
  }
  .attempts {
    display: grid;
    gap: 0.25rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-stretch: 87.5%;
    font-size: 0.72rem;
    line-height: 1.45;
  }
  .att {
    display: grid;
    grid-template-columns: 0.9rem minmax(0, 1fr);
    gap: 0.35rem;
  }
  .att[data-state='idle'] {
    display: none;
  }
  .att-mark {
    font-weight: 700;
    color: var(--accent);
  }
  .att[data-ok='false'],
  .att[data-ok='false'] .att-mark {
    color: var(--stop);
  }
  .att[data-state='shown'] {
    animation: att-in 0.3s var(--ease);
  }
  @keyframes att-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .src-wait {
    display: none;
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: var(--text-2);
  }
  .rec[data-phase='idle'] .src-wait {
    display: block;
  }
  .rec[data-phase='idle'] .rcard--out,
  .rec[data-phase='idle'] .rcard--review,
  .rec[data-phase='running'] .rcard--out,
  .rec[data-phase='running'] .rcard--review {
    display: none;
  }

  .rules {
    display: grid;
    gap: 0.5rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }
  .rule {
    display: grid;
    grid-template-columns: 0.7rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: baseline;
    font-size: 0.9rem;
    line-height: 1.35;
  }
  .rule-led {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: var(--line-3);
    transform: translateY(1px);
    transition:
      background 0.25s ease,
      box-shadow 0.25s ease;
  }
  .rule[data-state='pass'] .rule-led {
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .rule[data-state='fail'] .rule-led {
    background: var(--stop);
    box-shadow: 0 0 0 3px var(--stop-soft);
  }
  .rule-text {
    display: grid;
    transition: opacity 0.25s ease;
  }
  .rule[data-state='idle'] .rule-text {
    opacity: 0.45;
  }
  .rule[data-state='fail'] .rule-text > span:first-child {
    color: var(--stop);
  }
  .rule-eng {
    font-family: var(--mono);
    font-stretch: 87.5%;
    font-size: 0.72rem;
    color: var(--text-3);
  }

  .lab-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.2rem;
    padding-top: 1rem;
  }
  .lab-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .lbtn {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    font-size: 0.93rem;
    font-weight: 620;
  }
  .lbtn--go {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }
  .lbtn--go:hover {
    background: var(--accent-hi);
  }
  .lbtn[aria-disabled='true'] {
    opacity: 0.35;
    cursor: default;
  }
  .lab-msg {
    font-size: 0.97rem;
    font-weight: 560;
  }

  @media (max-width: 859px) {
    .lanes {
      grid-template-columns: minmax(0, 1fr);
    }
    .pipe {
      width: 2px;
      height: 1.6rem;
      background: repeating-linear-gradient(180deg, var(--line-3) 0 6px, transparent 6px 11px);
      background-size: 2px 11px;
    }
    .rec[data-phase='running'] .pipe {
      background-image: repeating-linear-gradient(180deg, var(--accent) 0 6px, transparent 6px 11px);
      animation-name: flow-y;
    }
    @keyframes flow-y {
      to {
        background-position: 0 11px;
      }
    }
    @keyframes arrive {
      from {
        opacity: 0;
        transform: translateY(-12px);
      }
    }
  }
</style>

<script>
  type Phase = 'idle' | 'running' | 'done' | 'again';
  // Under reduced motion the rules still tick in order, faster and
  // without the sliding card or moving pipe.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STEP = reduceMotion ? 200 : 380;

  document.querySelectorAll<HTMLElement>('[data-lab]').forEach((lab) => {
    const picks = [...lab.querySelectorAll<HTMLButtonElement>('.pick')];
    const recs = [...lab.querySelectorAll<HTMLElement>('.rec')];
    const live = lab.querySelector<HTMLElement>('[data-live]');
    let timers: number[] = [];

    const clearTimers = () => {
      timers.forEach((t) => window.clearTimeout(t));
      timers = [];
    };
    const btn = (rec: HTMLElement, act: string) => rec.querySelector<HTMLButtonElement>(`[data-lab-act="${act}"]`);

    const setRaw = (rec: HTMLElement, on: boolean) => {
      rec.dataset.raw = on ? 'on' : 'off';
      const raw = rec.querySelector('[data-count="raw"]');
      if (raw) raw.textContent = on ? '1' : '0';
    };

    const setPhase = (rec: HTMLElement, phase: Phase, speak = true) => {
      rec.dataset.phase = phase;
      const settled = phase === 'done' || phase === 'again';
      const clean = rec.querySelector('[data-count="clean"]');
      const review = rec.querySelector('[data-count="review"]');
      if (clean) clean.textContent = settled && rec.dataset.to === 'clean' ? '1' : '0';
      if (review) review.textContent = settled && rec.dataset.to === 'review' ? '1' : '0';
      btn(rec, 'run')?.setAttribute('aria-disabled', String(phase !== 'idle'));
      btn(rec, 'again')?.setAttribute('aria-disabled', String(!settled));
      btn(rec, 'reset')?.setAttribute('aria-disabled', String(!settled));
      const key = `msg${phase[0].toUpperCase()}${phase.slice(1)}`;
      const msg = rec.dataset[key] ?? '';
      const out = rec.querySelector('[data-msg]');
      if (out) out.textContent = msg;
      if (speak && live) live.textContent = msg;
    };

    const reset = (rec: HTMLElement, speak = true) => {
      clearTimers();
      rec.querySelectorAll<HTMLElement>('.rule, .att').forEach((r) => (r.dataset.state = 'idle'));
      setRaw(rec, false);
      setPhase(rec, 'idle', speak);
    };

    const run = (rec: HTMLElement) => {
      clearTimers();
      const rules = [...rec.querySelectorAll<HTMLElement>('.rule')];
      const attempts = [...rec.querySelectorAll<HTMLElement>('.att')];
      setPhase(rec, 'running');
      // each failed fetch waits longer before the next try, like the real backoff
      let at = 0;
      attempts.forEach((a, i) => {
        at += i === 0 ? STEP : STEP * (i + 1);
        timers.push(window.setTimeout(() => (a.dataset.state = 'shown'), at));
      });
      at += STEP;
      timers.push(window.setTimeout(() => setRaw(rec, true), at));
      rules.forEach((r, i) =>
        timers.push(window.setTimeout(() => (r.dataset.state = r.dataset.final ?? 'pass'), at + STEP * (i + 1)))
      );
      timers.push(window.setTimeout(() => setPhase(rec, 'done'), at + STEP * (rules.length + 1) + 150));
    };

    const again = (rec: HTMLElement) => {
      setPhase(rec, 'again');
      const card = rec.querySelector<HTMLElement>('.rcard--out, .rcard--review');
      if (card && !reduceMotion) {
        card.classList.remove('pulse');
        void card.offsetWidth;
        card.classList.add('pulse');
      }
    };

    lab.addEventListener('click', (e) => {
      const b = (e.target as Element | null)?.closest<HTMLButtonElement>('button');
      if (!b || !lab.contains(b)) return;

      if (b.dataset.pick) {
        picks.forEach((p) => p.setAttribute('aria-pressed', String(p === b)));
        recs.forEach((r) => (r.hidden = r.dataset.rec !== b.dataset.pick));
        const shown = recs.find((r) => !r.hidden);
        if (shown) reset(shown);
        return;
      }

      const act = b.dataset.labAct;
      if (!act || b.getAttribute('aria-disabled') === 'true') return;
      const rec = b.closest<HTMLElement>('.rec');
      if (!rec) return;
      if (act === 'run') run(rec);
      if (act === 'again') again(rec);
      if (act === 'reset') {
        reset(rec);
        btn(rec, 'run')?.focus();
      }
    });

    recs.forEach((r) => reset(r, false));
  });
</script>
