---
/** The technical detail: one disclosure per panel, closed until someone wants it. */
import Flow from './Flow.astro';
import CodePanel from './CodePanel.astro';
import type { DeepPanel } from '../../data/stories/types';
import { ui, type Lang } from '../../data/ui';

interface Props {
  lang: Lang;
  panels: DeepPanel[];
}
const { lang, panels } = Astro.props;
const kinds = ui[lang].story.kinds;
---

<div class="deep">
  {
    panels.map((p) => (
      <details class="dp">
        <summary>
          <span class="dp-kind">{kinds[p.kind]}</span>
          <span class="dp-title">{p.title}</span>
          <span class="dp-sign" aria-hidden="true" />
        </summary>
        <div class="dp-body">
          {p.kind === 'flow' && <Flow paths={p.paths} note={p.note} />}
          {p.kind === 'code' && (
            <>
              <CodePanel label={p.label} code={p.code} />
              {p.note && <p class="dp-note">{p.note}</p>}
            </>
          )}
          {p.kind === 'pair' && (
            <>
              <div class="dp-pair">
                <CodePanel label={p.left.label} code={p.left.code} />
                <CodePanel label={p.right.label} code={p.right.code} />
              </div>
              {p.note && <p class="dp-note">{p.note}</p>}
            </>
          )}
          {p.kind === 'list' && (
            <ul class="dp-list">
              {p.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          )}
          {p.kind === 'text' && <p class="dp-text">{p.text}</p>}
        </div>
      </details>
    ))
  }
</div>

<style>
  .deep {
    border-top: 1px solid var(--line-2);
  }
  .dp {
    border-bottom: 1px solid var(--line);
  }
  .dp summary {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) 2.2rem;
    align-items: center;
    gap: 1rem;
    min-height: 3.8rem;
    padding: 0.8rem 0;
    cursor: pointer;
    list-style: none;
  }
  .dp summary::-webkit-details-marker {
    display: none;
  }
  .dp-kind {
    justify-self: start;
    padding: 0.18rem 0.55rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 580;
    color: var(--text-2);
  }
  .dp-title {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    transition: color 0.2s ease;
  }
  .dp summary:hover .dp-title {
    color: var(--accent);
  }
  .dp-sign {
    position: relative;
    justify-self: end;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--line-2);
    border-radius: 50%;
  }
  .dp-sign::before,
  .dp-sign::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.8rem;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }
  .dp-sign::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 0.3s var(--ease);
  }
  .dp[open] .dp-sign {
    border-color: var(--accent);
    color: var(--accent);
  }
  .dp[open] .dp-sign::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .dp-body {
    padding: 0.2rem 0 1.8rem calc(6rem + 1rem);
  }
  .dp[open] .dp-body {
    animation: dp-in 0.35s var(--ease-out);
  }
  @keyframes dp-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .dp-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .dp-note {
    margin-top: 1rem;
    max-width: 62ch;
    padding-left: 0.9rem;
    border-left: 2px solid var(--accent);
    font-weight: 560;
    line-height: 1.5;
  }
  .dp-list {
    display: grid;
    gap: 0.6rem;
    max-width: 70ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dp-list li {
    position: relative;
    padding-left: 1.3rem;
    line-height: 1.55;
    color: var(--text-2);
    text-wrap: pretty;
  }
  .dp-list li::before {
    content: '';
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 0.55rem;
    height: 1.5px;
    background: var(--accent);
  }
  .dp-text {
    max-width: 62ch;
    line-height: 1.6;
    color: var(--text-2);
    text-wrap: pretty;
  }
  @media (max-width: 760px) {
    .dp summary {
      grid-template-columns: minmax(0, 1fr) 2.2rem;
      row-gap: 0.4rem;
    }
    .dp-kind {
      grid-column: 1;
      grid-row: 1;
    }
    .dp-title {
      grid-column: 1;
      grid-row: 2;
    }
    .dp-sign {
      grid-column: 2;
      grid-row: 1 / 3;
    }
    .dp-body {
      padding-left: 0;
    }
    .dp-pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
