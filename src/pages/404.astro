---
import Base from '../layouts/Base.astro';
import { ui } from '../data/ui';

const en = ui.en.misc;
const fr = ui.fr.misc;
---

<Base lang="en" title="404 · Omar Bari" description="Page not found." path="/404/" altPath="/fr/" noindex>
  <section class="nf container">
    <p class="nf-code">404</p>
    <h1 class="display nf-title">{en.notFoundTitle}</h1>
    <p class="nf-line">{en.notFoundBody} <a class="go" href="/">{en.notFoundCta} →</a></p>
    <p class="nf-line" lang="fr">{fr.notFoundBody} <a class="go" href="/fr/">{fr.notFoundCta} →</a></p>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(4rem, 12vw, 8rem) 1rem;
  }
  .nf-code {
    font-family: var(--mono);
    font-stretch: 87.5%;
    color: var(--accent);
  }
  .nf-title {
    margin-top: 0.8rem;
    font-size: clamp(3rem, 1rem + 7vw, 6rem);
  }
  .nf-line {
    margin-top: 1.2rem;
    color: var(--text-2);
  }
</style>
