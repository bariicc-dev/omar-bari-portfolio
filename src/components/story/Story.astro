---
/**
 * A project page: the question from the homepage, answered at once, then
 * the artifact (slot), then three beats, then the detail for engineers.
 */
import { Image } from 'astro:assets';
import Deep from './Deep.astro';
import Nb from '../Nb.astro';
import { logos } from '../../data/logos';
import { orgNames, logoHeight } from '../../data/orgs';
import { stories, storyHref } from '../../data/stories';
import type { Slug } from '../../data/stories/types';
import { ui, type Lang } from '../../data/ui';

interface Props {
  lang: Lang;
  slug: Slug;
  repo?: string;
}
const { lang, slug, repo } = Astro.props;
const s = stories[slug][lang];
const next = stories[s.next][lang];
const u = ui[lang].story;
const root = lang === 'fr' ? '/fr/' : '/';
const beats = [
  { k: u.hard, v: s.hard, tone: 'stop' },
  { k: u.chose, v: s.chose, tone: 'accent' },
  { k: u.changed, v: s.changed, tone: 'info' },
];
---

<article class="story">
  <header class="container story-head">
    <a class="back" href={`${root}#work`}>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M14 8H3M7 3.5 2.5 8 7 12.5" stroke="currentColor" stroke-width="1.6"></path>
      </svg>
      {u.back}
    </a>
    <div class="ctx">
      {
        s.logos.map((k) => (
          <span class="ctx-logo">
            <Image src={logos[k]} alt={orgNames[k]} height={logoHeight[k]} densities={[1, 2]} />
          </span>
        ))
      }
      <p><Nb text={s.context} /></p>
    </div>
    <h1 class="display story-q"><span style={`view-transition-name: q-${slug}`}>{s.question}</span></h1>
    <p class="story-a"><Nb text={s.answer} /></p>
    {
      repo && (
        <a class="btn btn--ghost story-repo" href={repo} target="_blank" rel="noopener">
          {u.repo} <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </header>

  <section class="container story-art" aria-label={s.artLabel}>
    <slot />
  </section>

  <section class="container beats-wrap" aria-label={`${u.hard}, ${u.chose}, ${u.changed}`}>
    <ol class="beats">
      {
        beats.map((b) => (
          <li class={`beat beat--${b.tone}`}>
            <h2 class="beat-k">{b.k}</h2>
            <p class="beat-v">
              <Nb text={b.v} />
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container deep-wrap" aria-labelledby="deep-title">
    <div class="deep-head">
      <h2 id="deep-title" class="h3">{u.details}</h2>
      <p class="deep-line">{u.detailsLine}</p>
    </div>
    <Deep lang={lang} panels={s.deep} />
  </section>

  <nav class="container story-next" aria-label={u.next}>
    <a href={storyHref(lang, next.slug)}>
      <span class="next-k">{u.next}</span>
      <span class="next-q">
        {next.question}
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6"></path>
        </svg>
      </span>
    </a>
  </nav>
</article>

<style>
  .story-head {
    padding-top: clamp(1.4rem, 3.5vw, 2.4rem);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    font-size: 0.94rem;
    font-weight: 560;
    color: var(--text-2);
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  .back svg {
    transition: transform 0.22s var(--ease);
  }
  .back:hover svg {
    transform: translateX(-3px);
  }
  .ctx {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.8rem;
    margin-top: clamp(1.4rem, 4vw, 2.6rem);
    font-size: 0.95rem;
    color: var(--text-2);
  }
  .ctx-logo {
    display: inline-flex;
    align-items: center;
    height: 2.4rem;
    padding: 0.3rem 0.5rem;
    border-radius: 8px;
    background: #fff;
  }
  .ctx-logo :global(img) {
    width: auto;
    object-fit: contain;
  }
  .story-q {
    margin-top: 1.2rem;
    max-width: 18em;
    font-size: clamp(2.3rem, 1.3rem + 3.6vw, 4.2rem);
  }
  .story-a {
    margin-top: 1.3rem;
    max-width: 38em;
    font-size: clamp(1.15rem, 1rem + 0.55vw, 1.4rem);
    line-height: 1.45;
    color: var(--text-2);
    text-wrap: pretty;
  }
  .story-repo {
    margin-top: 1.6rem;
  }
  .story-art {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .beats-wrap {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
  }
  .beats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .beat {
    position: relative;
    padding: 1.3rem 1.3rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
  }
  .beat::before {
    content: '';
    display: block;
    width: 28px;
    height: 3px;
    margin-bottom: 1rem;
    border-radius: 2px;
    background: var(--tone);
  }
  .beat--stop {
    --tone: var(--stop);
  }
  .beat--accent {
    --tone: var(--accent);
  }
  .beat--info {
    --tone: var(--info);
  }
  .beat-k {
    font-size: 1.05rem;
    font-stretch: 106%;
    font-weight: 640;
    letter-spacing: -0.01em;
  }
  .beat-v {
    margin-top: 0.55rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .deep-wrap {
    margin-top: clamp(3.5rem, 7vw, 5rem);
  }
  .deep-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 2rem;
    margin-bottom: 1.2rem;
  }
  .deep-line {
    color: var(--text-2);
  }

  .story-next {
    margin-top: clamp(3.5rem, 7vw, 5rem);
  }
  .story-next a {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.3rem, 3vw, 2rem);
    border: 1px solid var(--line-2);
    border-radius: 22px;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    text-decoration: none;
    transition:
      border-color 0.25s ease,
      transform 0.25s var(--ease);
  }
  .story-next a:hover {
    border-color: var(--line-3);
    transform: translateY(-2px);
  }
  .next-k {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }
  .next-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2.1rem);
    font-stretch: 108%;
    font-weight: 630;
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .next-q svg {
    flex: none;
    transition: transform 0.25s var(--ease);
  }
  .story-next a:hover .next-q svg {
    transform: translateX(5px);
  }
  @media (max-width: 899px) {
    .beats {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
